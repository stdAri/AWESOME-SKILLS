# .claude/.env.example
# API Keys for research tools
#
# Usage:
#   1. Copy this file to .claude/.env
#   2. Fill in your API keys
#   3. Claude Code will automatically load these as environment variables
#
# Note: .claude/.env should be added to .gitignore to avoid committing secrets

# ============================================================================
# OpenAlex - Open academic graph
# ============================================================================
# Optional: Free tier available without key ($0.01/day)
# With key: $1/day free (10,000 list calls, 1,000 search calls)
# Get key from: https://openalex.org/
# OPENALEX_API_KEY=your-openalex-key-here

# Optional: Email for polite pool (faster response times)
# OPENALEX_EMAIL=your-email@example.com

# ============================================================================
# Semantic Scholar - Published venue papers
# ============================================================================
# Optional: Higher rate limits with key (10 req/s vs 1 req/s)
# Get key from: https://www.semanticscholar.org/product/api#api-key-form
# SEMANTIC_SCHOLAR_API_KEY=your-s2-key-here

# ============================================================================
# Gemini - AI-powered literature discovery
# ============================================================================
# Required for /gemini-search skill
# Get key from: https://aistudio.google.com/apikey
# Free tier: 500 requests/min for gemini-2.5-flash
# GEMINI_API_KEY=your-gemini-key-here

# ============================================================================
# Exa - AI-powered web search
# ============================================================================
# Required for /exa-search skill
# Get key from: https://exa.ai/
# EXA_API_KEY=your-exa-key-here

# ============================================================================
# Zotero - Personal reference manager (if using Zotero MCP)
# ============================================================================
# Optional: Only needed if using Zotero MCP integration
# Get from: https://www.zotero.org/settings/keys
# ZOTERO_API_KEY=
# ZOTERO_USER_ID=

# ============================================================================
# Other research tools
# ============================================================================
# Add your other API keys here as needed
